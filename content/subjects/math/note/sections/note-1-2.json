{
  "id": "note-1-2",
  "chapterKey": "1",
  "number": 2,
  "title": "数の大小",
  "workbookPages": "p.14–15",
  "textbookRef": "教科書 P.25〜27",
  "blocks": [
    {
      "id": "note-1-2-intro",
      "type": "intro",
      "number": 2,
      "title": "数の大小",
      "workbookPages": "p.14–15",
      "textbookRef": "教科書 P.25〜27"
    },
    {
      "id": "note-1-2-teach-line",
      "type": "teach",
      "heading": "数直線",
      "statement": "0 を原点として、右を正の方向、左を負の方向とした直線。数直線上の点は、その数に対応する。",
      "highlightPhrases": ["原点", "正の方向", "負の方向"],
      "examples": ["点A に対応する数は －2", "点B に対応する数は ＋3.5"]
    },
    {
      "id": "note-1-2-teach-abs",
      "type": "teach",
      "heading": "絶対値",
      "statement": "数直線上で、ある数に対応する点と原点との距離。",
      "highlightPhrases": ["原点との距離"],
      "examples": ["点A に対応する数は －2　→　－2 の絶対値は 2", "点B に対応する数は ＋3.5　→　＋3.5 の絶対値は 3.5"],
      "aside": "＋と－の符号をとったものが、その数の絶対値であると考えることもできるよ。"
    },
    {
      "id": "note-1-2-teach-order",
      "type": "teach",
      "heading": "数の大小",
      "statement": "数直線上では、右にある数ほど大きく、左にある数ほど小さい。",
      "highlightPhrases": ["右にある数ほど大きく", "左にある数ほど小さい"],
      "examples": ["－2 ＜ ＋3.5", "－5 ＜ －3"],
      "aside": "数の大小は、＋－の符号と絶対値から判断できるよ。"
    },
    {
      "id": "note-1-2-point",
      "type": "point",
      "heading": "数の大小",
      "bullets": [
        "正の数は 0 より大きく、負の数は 0 より小さい。",
        "正の数は、絶対値が大きいほど大きい。",
        "負の数は、絶対値が大きいほど小さい。"
      ]
    },
    {
      "id": "note-1-2-a",
      "type": "qset",
      "label": "A問題",
      "questions": [
        {
          "number": 1,
          "topic": "数直線",
          "tag": "知・技",
          "textbookRef": "教 P.25 問1",
          "prompt": "下の数直線で、点A〜D に対応する数を答えなさい。",
          "widget": {
            "kind": "number-line-points",
            "numberLine": {
              "min": -5,
              "max": 5,
              "step": 0.5,
              "points": [
                { "label": "A", "value": 3 },
                { "label": "B", "value": -1 },
                { "label": "C", "value": 0.5 },
                { "label": "D", "value": -4.5 }
              ]
            }
          }
        },
        {
          "number": 2,
          "topic": "数直線",
          "tag": "知・技",
          "textbookRef": "教 P.25 問2",
          "prompt": "下の数直線上に、次の数に対応する点をしるしなさい。",
          "given": "A －3　　B ＋4　　C ＋2.5　　D －3/2",
          "widget": {
            "kind": "number-line-plot",
            "numberLine": {
              "min": -5,
              "max": 5,
              "step": 0.5,
              "points": [
                { "label": "A －3", "value": -3 },
                { "label": "B ＋4", "value": 4 },
                { "label": "C ＋2.5", "value": 2.5 },
                { "label": "D －3/2", "value": -1.5 }
              ]
            }
          }
        },
        {
          "number": 3,
          "topic": "数の大小",
          "tag": "知・技",
          "textbookRef": "教 P.26",
          "prompt": "次の2つの数のうち、大きい数はどちらですか。",
          "parts": [
            {
              "label": "(1)",
              "prompt": "－6、＋1",
              "choices": ["－6", "＋1"],
              "correct": [1],
              "answer": "正の数は 0 より大きく、負の数は 0 より小さいので ＋1 の方が大きい。",
              "source": "再計算で確認。"
            },
            {
              "label": "(2)",
              "prompt": "0、－3",
              "choices": ["0", "－3"],
              "correct": [0],
              "answer": "負の数は 0 より小さいので 0 の方が大きい。",
              "source": "再計算で確認。"
            },
            {
              "label": "(3)",
              "prompt": "－9、－5",
              "choices": ["－9", "－5"],
              "correct": [1],
              "answer": "負の数は絶対値が大きいほど小さい。|－9| = 9、|－5| = 5 だから －5 の方が大きい。",
              "source": "再計算で確認。"
            }
          ]
        },
        {
          "number": 4,
          "topic": "数の大小",
          "tag": "知・技",
          "textbookRef": "教 P.26 問4",
          "prompt": "次の各組の数の大小を、不等号を使って表しなさい。",
          "parts": [
            {
              "label": "(1)",
              "prompt": "－7、＋4",
              "accept": ["-7<+4", "+4>-7"],
              "answer": "－7 ＜ ＋4。（＋4 ＞ －7 と書いてもよい。）",
              "source": "再計算で確認。"
            },
            {
              "label": "(2)",
              "prompt": "－1、－5",
              "accept": ["-5<-1", "-1>-5"],
              "answer": "負の数どうしは絶対値が大きいほど小さいので －5 ＜ －1。",
              "source": "再計算で確認。"
            },
            {
              "label": "(3)",
              "prompt": "0、－6、＋2",
              "accept": ["-6<0<+2", "+2>0>-6"],
              "answer": "小さい順に並べて －6 ＜ 0 ＜ ＋2。3つ並べるときは不等号の向きをそろえる。",
              "source": "再計算で確認。"
            }
          ]
        },
        {
          "number": 5,
          "topic": "絶対値",
          "tag": "知・技",
          "textbookRef": "教 P.27 例",
          "prompt": "次の数の絶対値を答えなさい。",
          "parts": [
            {
              "label": "(1)",
              "prompt": "＋7",
              "accept": ["7"],
              "answer": "符号をとって 7。",
              "source": "再計算で確認。"
            },
            {
              "label": "(2)",
              "prompt": "－3",
              "accept": ["3"],
              "answer": "符号をとって 3。絶対値は距離なので負にならない。",
              "source": "再計算で確認。"
            },
            {
              "label": "(3)",
              "prompt": "－0.6",
              "accept": ["0.6"],
              "answer": "符号をとって 0.6。",
              "source": "再計算で確認。"
            },
            {
              "label": "(4)",
              "prompt": "－5/8",
              "accept": ["5/8"],
              "answer": "符号をとって 5/8。",
              "source": "再計算で確認。"
            }
          ]
        },
        {
          "number": 6,
          "topic": "絶対値",
          "tag": "知・技",
          "textbookRef": "教 P.27 問6",
          "prompt": "絶対値が次のようになる数を、すべて答えなさい。",
          "parts": [
            {
              "label": "(1)",
              "prompt": "14",
              "accept": ["+14, -14"],
              "unordered": true,
              "answer": "原点から距離14の点は右と左に1つずつ。＋14 と －14。",
              "source": "再計算で確認。"
            },
            {
              "label": "(2)",
              "prompt": "6/7",
              "accept": ["+6/7, -6/7"],
              "unordered": true,
              "answer": "＋6/7 と －6/7 の2つ。",
              "source": "再計算で確認。"
            },
            {
              "label": "(3)",
              "prompt": "0",
              "accept": ["0"],
              "answer": "原点との距離が 0 になるのは原点だけなので 0 のみ。ここだけ答えが1つになる。",
              "source": "再計算で確認。"
            }
          ]
        },
        {
          "number": 7,
          "topic": "負の数の大小",
          "tag": "知・技",
          "textbookRef": "教 P.27 問7",
          "prompt": "次の各組の数の大小を、不等号を使って表しなさい。",
          "parts": [
            {
              "label": "(1)",
              "prompt": "－0.3、－0.03",
              "accept": ["-0.3<-0.03", "-0.03>-0.3"],
              "answer": "|－0.3| = 0.3、|－0.03| = 0.03。負の数は絶対値が大きいほど小さいので －0.3 ＜ －0.03。",
              "source": "再計算で確認。"
            },
            {
              "label": "(2)",
              "prompt": "－2、－8/3",
              "accept": ["-8/3<-2", "-2>-8/3"],
              "answer": "－8/3 = －2.666… なので絶対値は 8/3 ＞ 2。負の数だから －8/3 ＜ －2。",
              "source": "再計算で確認。"
            }
          ]
        }
      ]
    },
    {
      "id": "note-1-2-b",
      "type": "qset",
      "label": "B問題",
      "questions": [
        {
          "number": 1,
          "tag": "知・技",
          "prompt": "次の数について、あとの問いに答えなさい。",
          "given": "－0.6、＋1.8、0、＋5/6、－7/2、－2",
          "parts": [
            {
              "label": "(1)",
              "prompt": "絶対値が最も大きい数はどれですか。",
              "accept": ["-7/2"],
              "answer": "絶対値は 0.6、1.8、0、5/6、7/2 = 3.5、2。いちばん大きいのは 3.5 なので －7/2。",
              "source": "再計算で確認。"
            },
            {
              "label": "(2)",
              "prompt": "小さい順に並べなさい。",
              "accept": ["-7/2, -2, -0.6, 0, +5/6, +1.8"],
              "answer": "－7/2 = －3.5、＋5/6 ≒ 0.83 として数直線の左から並べる。－7/2、－2、－0.6、0、＋5/6、＋1.8。",
              "source": "再計算で確認。"
            }
          ]
        },
        {
          "number": 2,
          "tag": "知・技",
          "prompt": "絶対値が4より小さい整数をすべて答えなさい。",
          "parts": [
            {
              "accept": ["-3, -2, -1, 0, +1, +2, +3"],
              "unordered": true,
              "answer": "絶対値が4より小さいので、4 そのものは入らない。－3、－2、－1、0、＋1、＋2、＋3 の7つ。",
              "source": "再計算で確認。"
            }
          ]
        },
        {
          "number": 3,
          "tag": "思・判・表",
          "deepen": true,
          "prompt": "－3、＋7、－4 の大小を、不等号を使って、－3 ＜ ＋7 ＞ －4 と表すのはまちがいである。その理由を説明し、不等号を使って正しく表しなさい。",
          "parts": [
            {
              "label": "理由",
              "answer": "不等号の向きがそろっていないから。－3 ＜ ＋7 ＞ －4 では ＋7 がいちばん大きいことしかわからず、－3 と －4 のどちらが大きいかを表せていない。",
              "source": "再計算で確認。"
            },
            {
              "label": "正しい表し方",
              "accept": ["-4<-3<+7", "+7>-3>-4"],
              "answer": "小さい順にそろえて －4 ＜ －3 ＜ ＋7。（大きい順に ＋7 ＞ －3 ＞ －4 でもよい。）",
              "source": "再計算で確認。"
            }
          ]
        }
      ]
    },
    {
      "id": "note-1-2-carry",
      "type": "carry",
      "text": "C問題（p.40）の ② もやってみよう！"
    }
  ]
}
