              "label": "(5)",
              "prompt": "b＝－3 のとき、b/9 の値",
              "accept": ["-1/3"],
              "answer": "（－3）÷9 ＝ －3/9 ＝ －1/3。約分するところまでが答え。",
              "source": "再計算で確認。"
            }
          ]
