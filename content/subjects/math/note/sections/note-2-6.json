            },
            {
              "label": "(2)",
              "prompt": "（－4a）÷（－6）",
              "accept": ["2a/3", "2/3a"],
              "answer": "（－4）÷（－6）＝＋4/6＝2/3 で 2/3 a。同符号だから ＋、そして約分。",
              "source": "再計算で確認。"
            },
            {
              "label": "(3)",
              "prompt": "6b ÷（－2/3）",
              "accept": ["-9b"],
              "answer": "6÷（－2/3）＝6×（－3/2）＝－9 で －9b。分数でわるのは逆数をかけること。",
              "source": "再計算で確認。"
            },
            {
              "label": "(4)",
              "prompt": "（－3/8 x）÷ 9/4",
              "accept": ["-x/6", "-1/6x"],
              "answer": "（－3/8）÷（9/4）＝（－3/8）×（4/9）＝－12/72＝－1/6 で －1/6 x。3 と 9、4 と 8 を先に約分すると速い。",
              "source": "再計算で確認。"
            }
          ]
        },
        {
          "number": 3,
          "topic": "項が2つの1次式と数の乗法",
          "tag": "知・技",
          "textbookRef": "教 P.80 問10・問11",
          "prompt": "次の計算をしなさい。かっこの中の項を1つずつタップして、外の数をぜんぶにかけよう。",
          "widget": {
            "kind": "distribute",
            "distribute": {
              "problems": [
                {
                  "expression": "2(5x－3)",
                  "multiplier": "2",
                  "terms": [
                    { "term": "5x", "becomes": "10x" },
                    { "term": "－3", "becomes": "－6" }
                  ],
                  "answer": "10x－6",
                  "accept": ["10x-6"],
                  "note": "2 は 5x にも －3 にもかかる。"
                },
                {
                  "expression": "(a＋4)×(－3)",
                  "multiplier": "－3",
                  "terms": [
                    { "term": "a", "becomes": "－3a" },
                    { "term": "＋4", "becomes": "－12" }
                  ],
                  "answer": "－3a－12",
                  "accept": ["-3a-12"],
                  "note": "かける数が負なので、中の項は両方とも符号が変わる。"
                },
                {
                  "expression": "－(x－7)",
                  "multiplier": "－1",
                  "terms": [
                    { "term": "x", "becomes": "－x" },
                    { "term": "－7", "becomes": "＋7" }
                  ],
                  "answer": "－x＋7",
                  "accept": ["-x+7", "7-x"],
                  "note": "前の － は「－1をかける」という意味。だから中の項ぜんぶの符号が反対になる。－x－7 としないこと。"
                },
                {
                  "expression": "－1/2(6x－2)",
                  "multiplier": "－1/2",
                  "terms": [
                    { "term": "6x", "becomes": "－3x" },
                    { "term": "－2", "becomes": "＋1" }
                  ],
                  "answer": "－3x＋1",
                  "accept": ["-3x+1", "1-3x"],
                  "note": "分数をかけるときも同じ。6×（－1/2）＝－3、（－2）×（－1/2）＝＋1。"
                }
              ]
            }
          }
        },
        {
          "number": 4,
          "topic": "項が2つの1次式と数の除法",
          "tag": "知・技",
          "textbookRef": "教 P.81 問12",
          "prompt": "次の計算をしなさい。わり算も「ぜんぶをわる」。1つの項だけわって、もう1つをそのまま残さないこと。",
          "parts": [
            {
              "label": "(1)",
              "prompt": "（18x＋24）÷6",
              "accept": ["3x+4"],
              "answer": "18÷6＝3、24÷6＝4。答えは 3x＋4。24 のほうもわるのを忘れずに。",
              "source": "再計算で確認。"
            },
            {
              "label": "(2)",
              "prompt": "（21x＋9）÷（－3）",
              "accept": ["-7x-3"],
              "answer": "21÷（－3）＝－7、9÷（－3）＝－3。答えは －7x－3。両方とも符号が変わる。",
              "source": "再計算で確認。"
            },
            {
              "label": "(3)",
              "prompt": "（4a－2）÷（－4）",
              "accept": ["-a+1/2", "1/2-a"],
              "answer": "4÷（－4）＝－1、（－2）÷（－4）＝＋1/2。答えは －a＋1/2。わり切れずに分数になることもある。",
              "source": "再計算で確認。"
            }
          ]
        }
      ]
    },
    {
      "id": "note-2-6-b",
      "type": "qset",
      "label": "B問題",
      "questions": [
        {
          "number": 1,
          "tag": "知・技",
          "prompt": "次の計算をしなさい。",
          "parts": [
            {
              "label": "(1)",
              "prompt": "（－6a）×（－1.5）",
              "accept": ["9a"],
              "answer": "（－6）×（－1.5）＝＋9 で 9a。小数でも符号の決め方は同じ。",
              "source": "再計算で確認。"
            },
            {
              "label": "(2)",
              "prompt": "1/3 x ÷ 1/2",
              "accept": ["2x/3", "2/3x"],
              "answer": "1/3 ÷ 1/2 ＝ 1/3 × 2 ＝ 2/3 で 2/3 x。わる数の逆数をかける。",
              "source": "再計算で確認。"
            },
            {
              "label": "(3)",
              "prompt": "（3/4 x － 1/6）×（－12）",
              "accept": ["-9x+2", "2-9x"],
              "answer": "3/4×（－12）＝－9、（－1/6）×（－12）＝＋2。答えは －9x＋2。分数と大きい数をかけるときは、先に約分すると暗算でできる。",
              "source": "再計算で確認。"
            },
            {
              "label": "(4)",
              "prompt": "（6y－12）÷（－4/3）",
              "accept": ["-9y/2+9", "9-9y/2", "-4.5y+9"],
              "answer": "（－4/3）でわるのは（－3/4）をかけること。6×（－3/4）＝－18/4＝－9/2、（－12）×（－3/4）＝＋9。答えは －9/2 y ＋9。",
              "source": "再計算で確認。"
            }
          ]
        },
        {
          "number": 2,
          "tag": "思・判・表",
          "deepen": true,
          "prompt": "次の計算にはまちがいがある。どうまちがえたかを説明しなさい。また、正しい答えを求めなさい。",
          "given": "（10a－5）÷5 ＝ (10a－5)/5 ＝ 2a－5",
          "parts": [
            {
              "label": "説明",
              "prompt": "どこがまちがい？　ノートに書いてから、たしかめよう。",
              "answer": "わり算をしたのが 10a だけで、－5 をそのまま下ろしてしまっている。分数の形にしたとき、約分できるのは「分子ぜんぶ」と分母。分子の一部分だけを勝手に約分することはできない。／この式は（10a－5）× 1/5 ということだから、10a にも －5 にも 1/5 をかけないといけない。1つの項だけにかけて満足してしまう、というのがこの節でいちばん多いまちがいだよ。",
              "source": "再計算で確認。(10a−5)/5＝2a−1 であって 2a−5 ではない。"
            },
            {
              "label": "正しい答え",
              "prompt": "正しく計算すると？",
              "accept": ["2a-1"],
              "answer": "10a÷5＝2a、（－5）÷5＝－1。答えは 2a－1。／たしかめ：a＝1 を入れてみると、もとの式は（10－5）÷5＝1。2a－1 なら 2－1＝1 で合う。まちがった 2a－5 なら 2－5＝－3 で合わない。数を1つ入れてみると、まちがいはすぐ見つかる。",
              "source": "再計算で確認。a＝1 での検算も一致。"
            }
          ]
        }
      ]
    }
  ]
