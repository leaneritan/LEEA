  "blocks": [
    {
      "id": "note-2-drill4-intro",
      "type": "intro",
      "title": "特訓ドリル④　1次式の計算",
      "workbookPages": "p.54–55",
      "textbookRef": "5〜7節の内容を特訓！"
    },
    {
      "id": "note-2-drill4-teach",
      "type": "teach",
      "heading": "このページの使い方",
      "statement": "5節から7節までの1次式の計算を、スピードをつけて身につけるページ。時間をはかって、まちがえた問題だけをもう一度やろう。",
      "highlightPhrases": ["時間をはかって", "まちがえた問題だけ"],
      "aside": "このドリルは本では8節のうしろ（p.54〜55）に印刷されているけれど、特訓するのは5〜7節の内容だよ。ページの順番と、習う順番がここだけずれている。／1次式の計算でまちがえる原因はだいたい3つ——かっこの前が － のとき中の符号を変え忘れた、分配法則で1つの項にしかかけなかった、文字の項と数の項をまぜてしまった。どれだったか確かめよう。"
    },
    {
      "id": "note-2-drill4-a",
      "type": "qset",
      "label": "A問題",
      "questions": [
        {
          "number": 1,
          "topic": "1次式の加法，減法",
          "tag": "知・技",
          "prompt": "次の計算をしなさい。",
          "widget": {
            "kind": "drill",
            "drill": {
              "backRef": "p.48〜49",
              "hint": "文字が同じ項どうし、数の項どうしをまとめます。かっこの前が － のときは、かっこの中の各項の符号を変えて、かっこをはずします。",
              "items": [
                { "expression": "5a＋8a", "answer": "13a", "accept": ["13a"], "note": "（5＋8）a＝13a。" },
                { "expression": "4x－7x", "answer": "－3x", "accept": ["-3x"], "note": "（4－7）x＝－3x。係数だけを計算する。" },
                { "expression": "x/2 － x/3", "answer": "x/6", "accept": ["x/6", "1/6x"], "tag": "三重", "note": "（1/2－1/3）x＝（3/6－2/6）x＝1/6 x。" },
                { "expression": "1/3 a － a ＋ 5/2 a", "answer": "11a/6", "accept": ["11a/6", "11/6a"], "tag": "滋賀", "note": "1/3－1＋5/2＝（2－6＋15)/6＝11/6。だから 11/6 a。" },
                { "expression": "2n＋6－3n－10", "answer": "－n－4", "accept": ["-n-4"], "note": "文字の項 2n－3n＝－n、数の項 6－10＝－4。" },
                { "expression": "（5x－1）＋（5x－4）", "answer": "10x－5", "accept": ["10x-5"], "note": "たし算なのでかっこはそのまま外せる。5x＋5x＝10x、－1－4＝－5。" },
                { "expression": "9a－（a－1）", "answer": "8a＋1", "accept": ["8a+1"], "tag": "山口", "note": "9a－a＋1。－1 が ＋1 になる。8a＋1。" },
                { "expression": "7x－11－（－7x－5）", "answer": "14x－6", "accept": ["14x-6"], "tag": "鳥取", "note": "7x－11＋7x＋5。かっこの中の項が両方とも符号を変える。14x－6。" }
              ]
            }
          }
        },
        {
          "number": 2,
          "topic": "1次式と数の乗法",
          "tag": "知・技",
          "prompt": "次の計算をしなさい。",
          "widget": {
            "kind": "drill",
            "drill": {
              "backRef": "p.50〜51",
              "hint": "数どうしをかけ合わせます。項が2つある1次式に数をかけるときは、分配法則を使います。",
              "items": [
                { "expression": "5x×3", "answer": "15x", "accept": ["15x"], "note": "5×3＝15。" },
                { "expression": "－4a×（－7）", "answer": "28a", "accept": ["28a", "+28a"], "note": "（－4）×（－7）＝＋28。負×負で正。" },
                { "expression": "－2/3 x × 9", "answer": "－6x", "accept": ["-6x"], "note": "（－2/3）×9＝－6。3 と 9 を約分。" },
                { "expression": "2(5a＋3)", "answer": "10a＋6", "accept": ["10a+6"], "note": "2×5a＝10a、2×3＝6。ぜんぶにかける。" },
                { "expression": "－3(n－2)", "answer": "－3n＋6", "accept": ["-3n+6", "6-3n"], "note": "（－3）×n＝－3n、（－3）×（－2）＝＋6。" },
                { "expression": "（5a－1）×（－4）", "answer": "－20a＋4", "accept": ["-20a+4", "4-20a"], "note": "5a×（－4）＝－20a、（－1）×（－4）＝＋4。" },
                { "expression": "2/5 (20x－5)", "answer": "8x－2", "accept": ["8x-2"], "note": "20×2/5＝8、（－5）×2/5＝－2。" },
                { "expression": "－6( 2/3 x － 1/2 )", "answer": "－4x＋3", "accept": ["-4x+3", "3-4x"], "note": "（2/3）×（－6）＝－4、（－1/2）×（－6）＝＋3。" }
              ]
            }
          }
        },
        {
          "number": 3,
          "topic": "1次式と数の除法",
          "tag": "知・技",
          "prompt": "次の計算をしなさい。",
          "widget": {
            "kind": "drill",
            "drill": {
              "backRef": "p.50〜51",
              "hint": "除法はわる数の逆数をかける乗法になおすことができます。答えが分数になるときは、約分できるか確認しましょう。",
              "items": [
                { "expression": "8a÷2", "answer": "4a", "accept": ["4a"], "note": "8÷2＝4。" },
                { "expression": "－12x÷（－3）", "answer": "4x", "accept": ["4x", "+4x"], "tag": "三重", "note": "（－12）÷（－3）＝＋4。同符号の商は正。" },
                { "expression": "6y÷（－2/3）", "answer": "－9y", "accept": ["-9y"], "note": "6×（－3/2）＝－9。逆数をかける。" },
                { "expression": "（8x－4）÷4", "answer": "2x－1", "accept": ["2x-1"], "note": "8÷4＝2、（－4）÷4＝－1。両方わる。" },
                { "expression": "（12n＋18）÷（－6）", "answer": "－2n－3", "accept": ["-2n-3"], "note": "12÷（－6）＝－2、18÷（－6）＝－3。両方とも負に。" },
                { "expression": "（9x－6）÷ 3/2", "answer": "6x－4", "accept": ["6x-4"], "tag": "高知", "note": "×2/3 になおして 9×2/3＝6、（－6）×2/3＝－4。" }
              ]
            }
          }
        },
        {
          "number": 4,
          "topic": "分数の形をした1次式と数の乗法",
          "tag": "知・技",
          "prompt": "次の計算をしなさい。",
          "widget": {
            "kind": "drill",
            "drill": {
              "backRef": "p.52",
              "hint": "はじめに約分しましょう。その後は分配法則を使って計算します。",
              "items": [
                { "expression": "(x＋5)/6 × 12", "answer": "2x＋10", "accept": ["2x+10"], "note": "12÷6＝2 だから（x＋5）×2＝2x＋10。" },
                { "expression": "(3x－5)/2 ×（－10）", "answer": "－15x＋25", "accept": ["-15x+25", "25-15x"], "note": "（－10）÷2＝－5 だから（3x－5）×（－5）＝－15x＋25。" },
                { "expression": "（－27）× (－6a－2)/9", "answer": "18a＋6", "accept": ["18a+6"], "note": "（－27）÷9＝－3 だから（－6a－2）×（－3）＝18a＋6。どちらの項も符号が変わる。" }
              ]
            }
          }
        },
        {
          "number": 5,
          "topic": "かっこのついた式の計算",
          "tag": "知・技",
          "prompt": "次の計算をしなさい。",
          "widget": {
            "kind": "drill",
            "drill": {
              "backRef": "p.52",
              "hint": "分配法則を使ってかっこをはずし、文字の項と数の項をそれぞれまとめましょう。",
              "items": [
                { "expression": "2(a＋5)＋(7a－8)", "answer": "9a＋2", "accept": ["9a+2"], "tag": "山口", "note": "2a＋10＋7a－8。9a＋2。" },
                { "expression": "－2(a－4)＋5(a－3)", "answer": "3a－7", "accept": ["3a-7"], "tag": "和歌山", "note": "－2a＋8＋5a－15。3a－7。" },
                { "expression": "7(x＋2)＋6(x－4)", "answer": "13x－10", "accept": ["13x-10"], "note": "7x＋14＋6x－24。13x－10。" },
                { "expression": "4(2x－1)－3(2x－3)", "answer": "2x＋5", "accept": ["2x+5"], "tag": "鳥取", "note": "8x－4－6x＋9。（－3）×（－3）＝＋9 に注意。2x＋5。" },
                { "expression": "1/4 (8x－24) － 2/3 (3x－9)", "answer": "0", "accept": ["0"], "note": "（2x－6）－（2x－6）＝0。ぜんぶ消えて 0 になる。答えが 0 でも、それが正解だよ。" }
              ]
            }
          }
        }
      ]
    }
  ]
}
